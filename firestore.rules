rules_version = '2';

// -----------------------------------------------------------------------------
// IMPORTANT: this app has NO authentication (REQUIREMENTS §3). These rules can
// only validate document SHAPE and reject unknown paths — they are NOT an
// identity boundary. Anyone with the public web config could write. That is the
// explicitly accepted, trust-based model (unguessable admin URL + community
// trust). See ARCHITECTURE.md#security before hardening.
// -----------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // Global roster of people.
    match /roster/{personId} {
      allow read: if true;
      allow create, update: if isValidPerson(request.resource.data);
      allow delete: if true;
    }

    // Khatmas and their per-member assignments.
    match /khatmas/{khatmaId} {
      allow read: if true;
      allow create: if isValidKhatma(request.resource.data)
        && hasFullQuranScope(request.resource.data);
      allow update: if isValidKhatma(request.resource.data)
        && hasFullQuranScope(request.resource.data);
      allow delete: if true;
      match /assignments/{memberId} {
        allow read: if true;
        allow create, update: if isValidAssignment(request.resource.data);
        allow delete: if true;
      }
    }

    // Append-only member feedback messages. The app has no authentication, so
    // memberId/memberName are submitted metadata rather than a proven identity.
    match /content/feedback/messages/{feedbackId} {
      allow read: if true;
      allow create: if isValidFeedback(request.resource.data)
        && request.resource.data.isRead == false;
      allow update: if isValidFeedback(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if true;
    }

    // One explicit, series-wide admin-confirmed distribution operation.
    match /distributionRuns/{runId} {
      allow read: if true;
      allow create, update: if isValidDistributionRun(request.resource.data);
      allow delete: if true;
    }

    // Global admin-editable content (du3a text).
    match /content/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Deny any path not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidPerson(d) {
      return d.keys().hasOnly([
          'name', 'note', 'emoji', 'completedPages', 'pagesPerDay',
          'enabled', 'holdPages', 'createdAt'
        ])
        && d.name is string
        && d.name.size() > 0
        && (!('note' in d) || d.note is string)
        && d.completedPages is list
        && d.createdAt is number
        && d.pagesPerDay is number
        && d.enabled is bool
        && (!('holdPages' in d) || d.holdPages is bool)
        && (!('emoji' in d) || (d.emoji is string && d.emoji.size() > 0 && d.emoji.size() <= 16));
    }

    // Shape-only (types kept lenient to match the client writes; these rules can
    // never enforce identity in this no-auth app — see ARCHITECTURE.md#security).
    // Khatmas are open-ended series (Stage 3): no start date or duration —
    // `remainingPages` + `roundCount` drive admin-triggered distribution rounds.
    function isValidKhatma(d) {
      return d.seriesId is string
        && d.seriesName is string
        && d.seriesNumber is number
        && d.totalPages is number
        && d.memberIds is list
        && d.status is string
        && d.remainingPages is list
        && d.roundCount is number
        && d.createdAt is number
        && d.scope is map
        && d.capacities is map
        && d.duaReciterId is string
        && (!('imageName' in d) || d.imageName is string)
        && (!('lastDistributionDate' in d) || d.lastDistributionDate is string)
        && (!('currentDistributionRunId' in d) || d.currentDistributionRunId is string)
        && (!('distributionRevision' in d) || d.distributionRevision is number)
        && (!('completedAt' in d) || d.completedAt is number);
    }

    function hasFullQuranScope(d) {
      return d.scope.kind == 'full'
        && d.totalPages == 604
        && d.remainingPages.size() <= 604;
    }

    function isValidDistributionRun(d) {
      return d.keys().hasOnly([
          'seriesId', 'number', 'status', 'revision', 'mode', 'khatmaIds',
          'openedAt', 'updatedAt', 'closedAt', 'rollover'
        ])
        && d.seriesId is string
        && d.number is number
        && (d.status == 'open' || d.status == 'closed')
        && d.revision is number
        && (d.mode == 'new-round' || d.mode == 'adjust-current')
        && d.khatmaIds is list
        && d.openedAt is number
        && d.updatedAt is number
        && (!('closedAt' in d) || d.closedAt is number)
        && (!('rollover' in d) || d.rollover is map);
    }

    function isValidAssignment(d) {
      return d.memberId is string
        && d.rounds is list
        && d.doneByRound is map
        && d.missedStreak is number;
    }

    function isValidFeedback(d) {
      return d.keys().hasOnly([
          'memberId', 'memberName', 'message', 'isRead', 'createdAt'
        ])
        && d.memberId is string
        && d.memberId.size() > 0
        && d.memberName is string
        && d.memberName.size() > 0
        && d.message is string
        && d.message.size() >= 10
        && d.message.size() <= 500
        && d.isRead is bool
        && d.createdAt is number;
    }
  }
}
